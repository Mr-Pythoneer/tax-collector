<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TaxCore.Check: runs the TaxCore rule checks. Plain console app so it runs on
    the Mac with `dotnet run`, the Windows counterpart of `swift run taxcore-check`.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TaxCore.Check</RootNamespace>
    <AssemblyName>taxcore-check</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TaxCore/TaxCore.csproj" />
  </ItemGroup>

</Project>
